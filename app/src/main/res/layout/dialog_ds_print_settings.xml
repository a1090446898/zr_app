<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:paddingLeft="20dp"
              android:paddingTop="12dp"
              android:paddingRight="20dp"
              android:paddingBottom="4dp">

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打印分辨率"
            android:textColor="#333333"
            android:textSize="14sp" />

    <RadioGroup
            android:id="@+id/rgDpi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <RadioButton
                android:id="@+id/rbDpi203"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="203dpi（默认）"
                android:textSize="14sp" />

        <RadioButton
                android:id="@+id/rbDpi300"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="300dpi"
                android:textSize="14sp" />
    </RadioGroup>

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="整版偏移X（mm，正数右移）"
            android:textColor="#333333"
            android:textSize="14sp" />

    <EditText
            android:id="@+id/etOffsetX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="如 1.5 或 -1.5"
            android:inputType="numberDecimal|numberSigned"
            android:textSize="14sp" />

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="整版偏移Y（mm，正数下移）"
            android:textColor="#333333"
            android:textSize="14sp" />

    <EditText
            android:id="@+id/etOffsetY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="如 1.5 或 -1.5"
            android:inputType="numberDecimal|numberSigned"
            android:textSize="14sp" />

    <com.qmuiteam.qmui.layout.QMUIButton
            android:id="@+id/btnLocateLabel"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@color/app_color_blue"
            android:text="定位标签"
            android:textColor="@color/colorWhite" />

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="定位标签会让打印机走一张空白标签用于校准间隙，请确认已装纸。"
            android:textColor="#999999"
            android:textSize="12sp" />
</LinearLayout>