<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="#F2F3F5"
              android:orientation="vertical">

    <com.qmuiteam.qmui.widget.QMUITopBar
            android:id="@+id/topbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/qmui_topbar_height" />

    <!-- 盘点范围与进度卡片 -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="12dp">

        <!-- 盘点范围（不限行数完整显示） + 扫描状态 -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <TextView
                    android:id="@+id/tvContext"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="盘点范围："
                    android:textColor="#666666"
                    android:textSize="13sp" />

            <TextView
                    android:id="@+id/textScanState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:gravity="end"
                    android:text="按设备扫描键扫描"
                    android:textColor="#666666"
                    android:textSize="13sp" />
        </LinearLayout>

        <!-- 三列等分统计：数值在上(动态字号)标签在下 -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

            <LinearLayout
                    android:id="@+id/columnCounted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvCounted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/inventory_count_green"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="已盘"
                        android:textColor="#999999"
                        android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/columnUncounted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvUncounted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/inventory_count_red"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="未盘"
                        android:textColor="#999999"
                        android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/columnAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/inventory_count_black"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="全部"
                        android:textColor="#999999"
                        android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 非拥有产权资产统计（仅存放地点层显示）：管理部门与当前部门不一致的资产，细分已盘/未盘 -->
        <TextView
                android:id="@+id/tvNonOwnedAssets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="#E53935"
                android:textSize="12sp"
                android:visibility="gone" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="盘点扫描（开启后扫描自动标记盘实/已盘）"
                    android:textColor="#666666"
                    android:textSize="13sp" />

            <Switch
                    android:id="@+id/switchMarkStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
                android:id="@+id/textTagCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="列表共 0 条资产"
                android:textColor="#9E9E9E"
                android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="8dp">

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTags"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

        <TextView
                android:id="@+id/textEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:text="按下设备扫描键开始扫描\n扫描到的资产将显示在卡片列表中"
                android:textColor="#999999"
                android:textSize="14sp" />
    </FrameLayout>

    <!-- 批量变更地点：将本次扫描的标签存放地点统一修改（页面级操作） -->
    <com.qmuiteam.qmui.layout.QMUIButton
        android:id="@+id/btnBatchChangeLocation"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_rounded_button"
        android:text="批量变更地点"
        android:textColor="@color/colorWhite"
        android:textSize="16sp" />

    <!-- 开始/停止扫描：仅支持软触发的识别适配器显示（优博讯/东集旧机），纯广播设备隐藏 -->
    <com.qmuiteam.qmui.layout.QMUIButton
        android:id="@+id/buttonScan"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_rounded_button"
        android:text="开始扫描"
        android:textColor="@color/colorWhite"
        android:textSize="16sp"
        android:visibility="gone" />
</LinearLayout>