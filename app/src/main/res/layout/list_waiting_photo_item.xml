<?xml version="1.0" encoding="utf-8"?>
<!-- 待上传照片卡片项：照片名称作为标题，DOCID/条码编号/状态/路径竖向排列
     外层 FrameLayout 提供卡片间距（ListView 的 item 根布局 margin 不生效，用内边距实现） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingTop="5dp"
    android:paddingEnd="12dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_white"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 照片名称：卡片标题 -->
        <TextView
            android:id="@+id/tv_photo_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="照片名称"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#F0F0F0" />

        <!-- 账套ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="账套ID"
                android:textColor="#999999"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_acctsuite_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:textColor="#333333"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- DOCID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="DOCID"
                android:textColor="#999999"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_doc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:textColor="#333333"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 条码编号 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="条码编号"
                android:textColor="#999999"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:textColor="#333333"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 照片状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="照片状态"
                android:textColor="#999999"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="待上传"
                android:textColor="#333333"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 照片路径：不限行数完整显示，长路径自动换行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="照片路径"
                android:textColor="#999999"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:textColor="#666666"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 照片缺失提示：记录仍在但本地文件被删除/剪切时显示，默认隐藏不占位 -->
        <TextView
            android:id="@+id/tv_photo_missing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:includeFontPadding="false"
            android:text="照片缺失：本地照片文件不存在"
            android:textColor="@color/photo_missing_red"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
