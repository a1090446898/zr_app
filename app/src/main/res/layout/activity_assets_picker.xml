<?xml version="1.0" encoding="utf-8"?>
<!--
    公共选择资产页：主内容是资产列表，查询条件放在右侧抽屉面板里。
    顶栏"搜索"→ openDrawer 从右侧滑出；抽屉内为标签+输入框的表单，
    底部固定"重置""搜索"两个按钮（不随表单滚动）。
    各查询字段由 AssetsPickerOptions.visibleFilters 控制显隐。
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                           xmlns:app="http://schemas.android.com/apk/res-auto"
                                           android:id="@+id/lyDrawLayout"
                                           android:layout_width="match_parent"
                                           android:layout_height="match_parent">

    <!-- ==================== 主内容：资产列表 ==================== -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F2F3F5"
            android:orientation="vertical">

        <com.qmuiteam.qmui.widget.QMUITopBar
                android:id="@+id/topbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/qmui_topbar_height" />

        <!-- 全选条：只全选已加载的数据；单选/关闭全选时隐藏 -->
        <LinearLayout
                android:id="@+id/layoutSelectAll"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

            <CheckBox
                    android:id="@+id/cbSelectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:text="全选已加载"
                    android:textColor="#333333"
                    android:textSize="14sp" />

            <TextView
                    android:id="@+id/tvSelectedCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="#999999"
                    android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

            <ListView
                    android:id="@+id/listSource"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:scrollbars="none" />

            <LinearLayout
                    android:id="@+id/layoutEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                <TextView
                        android:id="@+id/tvEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="没有符合条件的资产"
                        android:textColor="#999999"
                        android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/layoutLoading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#80000000"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                <ProgressBar
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminateTint="@color/primary_color" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="正在查询…"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ==================== 右侧抽屉：查询条件 ==================== -->
    <LinearLayout
            android:id="@+id/lyQuery"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@color/white"
            android:orientation="vertical">

        <com.qmuiteam.qmui.widget.QMUITopBar
                android:id="@+id/querybar"
                android:layout_width="match_parent"
                android:layout_height="?attr/qmui_topbar_height" />

        <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                <LinearLayout
                        android:id="@+id/rowFilterAssetsName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="2dp">

                    <TextView
                            style="@style/from_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="0dp"
                            android:paddingEnd="12dp"
                            android:text="资产名称："/>

                    <EditText
                            android:id="@+id/editASSETSNAME"
                            style="@style/from_value"
                            android:layout_width="match_parent"
                            android:layout_marginTop="4dp"
                            android:hint="资产名称（模糊）"/>
                </LinearLayout>

                <LinearLayout
                        android:id="@+id/rowFilterBarcode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="2dp">

                    <TextView
                            style="@style/from_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="0dp"
                            android:paddingEnd="12dp"
                            android:text="条码编号："/>

                    <EditText
                            android:id="@+id/editBARCODEID"
                            style="@style/from_value"
                            android:layout_width="match_parent"
                            android:layout_marginTop="4dp"
                            android:hint="条码编号（模糊）"/>
                </LinearLayout>

                <LinearLayout
                        android:id="@+id/rowFilterAssetsDept"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="2dp">

                    <TextView
                            style="@style/from_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="0dp"
                            android:paddingEnd="12dp"
                            android:text="使用部门："/>

                    <EditText
                            android:id="@+id/editASSETSDEPT"
                            style="@style/from_value"
                            android:layout_width="match_parent"
                            android:layout_marginTop="4dp"
                            android:hint="使用部门（模糊）"/>
                </LinearLayout>

                <LinearLayout
                        android:id="@+id/rowFilterManageDept"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="2dp">

                    <TextView
                            style="@style/from_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="0dp"
                            android:paddingEnd="12dp"
                            android:text="管理部门："/>

                    <!-- 管理部门是字典数据，只能选不能输入；按钮内嵌输入框右端，与表单页样式一致 -->
                    <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp">

                        <EditText
                                android:id="@+id/editGROUNDMANAGEDEPT"
                                style="@style/from_value_picker"
                                android:clickable="true"
                                android:cursorVisible="false"
                                android:focusable="false"
                                android:focusableInTouchMode="false"
                                android:hint="管理部门"/>

                        <TextView
                                android:id="@+id/btnPickManageDept"
                                style="@style/from_action"
                                android:text="选择"/>
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                        android:id="@+id/rowFilterAssetsUser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="2dp">

                    <TextView
                            style="@style/from_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="0dp"
                            android:paddingEnd="12dp"
                            android:text="使&#8194;用&#8194;人："/>

                    <EditText
                            android:id="@+id/editASSETSUSER"
                            style="@style/from_value"
                            android:layout_width="match_parent"
                            android:layout_marginTop="4dp"
                            android:hint="使用人（模糊）"/>
                </LinearLayout>

                <LinearLayout
                        android:id="@+id/rowFilterLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="2dp">

                    <TextView
                            style="@style/from_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="0dp"
                            android:paddingEnd="12dp"
                            android:text="存放地点："/>

                    <EditText
                            android:id="@+id/editASSETSLAYADD"
                            style="@style/from_value"
                            android:layout_width="match_parent"
                            android:layout_marginTop="4dp"
                            android:hint="存放地点（模糊）"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 底部操作区：重置 + 搜索，固定在抽屉底部 -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

            <com.qmuiteam.qmui.widget.roundwidget.QMUIRoundButton
                    android:id="@+id/btnReset"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="重置"
                    android:textColor="#666666"
                    android:textSize="15sp"
                    app:qmui_backgroundColor="#F2F3F5"
                    app:qmui_radius="22dp" />

            <com.qmuiteam.qmui.widget.roundwidget.QMUIRoundButton
                    android:id="@+id/btnSearch"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="搜索"
                    android:textColor="@color/colorWhite"
                    android:textSize="15sp"
                    app:qmui_backgroundColor="@color/primary_color"
                    app:qmui_radius="22dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
