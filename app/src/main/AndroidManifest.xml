<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.gsoft.inventory">

    <!-- 新增：Android 11+ 包可见性声明，否则鸿蒙/Android 11+ 设备上相机Intent解析不到 -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- 华为/荣耀相机包名，兼容鸿蒙部分机型标准Intent解析失败的情况 -->
        <package android:name="com.huawei.camera" />
        <package android:name="com.huawei.hwcamera" />
        <package android:name="com.huawei.camera2" />
        <package android:name="com.huawei.camera3d" />
    </queries>

    <!-- 添加通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="com.vivo.notification.permission.BADGE_ICON" />
    <uses-permission android:name="com.vivo.abe.permission.launcher.notification.num" />
    <uses-permission android:name="com.huawei.android.launcher.permission.CHANGE_BADGE" />



    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MOUNT_UNMOUNT_FILESYSTEMS"
        tools:ignore="ProtectedPermissions" />


    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />


    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <application
        android:name=".InventoryApplication"
        android:allowBackup="true"
        android:icon="@mipmap/app_logo"
        android:label="@string/app_name"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_config"
        android:roundIcon="@mipmap/app_logo"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:requestLegacyExternalStorage="true">
        <!-- 东集(SEUIC)UHF系统库：required=false保证得实等其他设备可正常安装运行 -->
        <uses-library
            android:name="com.seuic.uhf"
            android:required="false" />
        <activity
            android:name=".ImportQCYActivity"
            android:exported="false" />
        <activity
            android:name=".UploadPhotoImagesActivity"
            android:exported="false" />
        <activity
            android:name=".SignaturePhotoViewActivity"
            android:exported="false" />
        <activity
            android:name=".SignatureActivity"
            android:exported="false" />
        <activity
            android:name=".OfflineHomeActivity"
            android:exported="true" />
        <activity android:name=".OfflineLoginActivity" />
        <activity android:name=".NetChooseActivity" />
        <activity android:name=".DisposeAssetsActivity" />
        <activity android:name=".AssetsDisposeActivity" />
        <activity android:name=".ImportPrintersActivity" />

        <!--数据库名称-->
        <meta-data
            android:name="DATABASE"
            android:value="xct_zcqc.db" />
        <!--数据库版本号，生成表需要更新该版本号,在assets，sugar_upgrades目录下新建version.sql文件-->
        <meta-data
            android:name="VERSION"
            android:value="65" />
        <meta-data
            android:name="QUERY_LOG"
            android:value="true" />
        <meta-data
            android:name="DOMAIN_PACKAGE_NAME"
            android:value="com.gsoft.inventory" />

<!--        <activity-->
<!--            android:name=".Activity111"-->
<!--            android:launchMode="singleTask" />-->
        <activity android:name=".BluetoothDeviceActivity" />
        <!-- 宝威打印机连接与打印页（RFID移动端网页二维码打印类型） -->
        <activity android:name=".BwPrintActivity" />
        <activity android:name=".DsPrintActivity" />
        <activity android:name=".RfidReadActivity" />
        <activity android:name=".InfraredReadActivity" />
        <activity android:name=".CameraReadActivity" />
        <activity android:name=".RfidStatsActivity" android:exported="false" />
        <activity android:name=".PrintLabelActivity" />
        <!--更新安装失败引导页-->
        <activity
            android:name=".update.UpdateManualInstallActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name=".ImportAssetsActivity" />
        <activity android:name=".AssetsQueryActivity" />
        <activity android:name=".AssetsViewActivity" />
        <activity android:name=".AssetsCodeScanActivity" />
        <activity android:name=".NewAssetsActivity" />
        <activity android:name=".ImportAccountsActivity" />
        <activity android:name=".ImportNetAssetsActivity" />
        <activity android:name=".ImportAssetsCategoryActivity" />
        <activity android:name=".LoginActivity" />
        <activity android:name=".EditAssetsActivity" />
        <activity android:name=".PhotoActivity" />
        <activity android:name=".PhotoViewActivity" />
<!--        <activity android:name=".ScanPhotoActivity" />-->

        <activity android:name=".QueryActivity" />
        <activity android:name=".AssetsRecodeActivity" />

        <!--扫码页面-->
        <activity android:name=".view.scan.BarcodeScannerActivity" android:hardwareAccelerated="true"/>

        <!--WEB页面，开启硬件加速-->
        <activity android:name=".view.web.WebIndex"
                  android:hardwareAccelerated="true"/>

        <!--PDF预览-->
        <activity android:name=".view.pdf_view.PdfViewerActivity"
                  android:hardwareAccelerated="true"/>

        <activity android:name=".view.AssetDiscardActivity" />
        <activity android:name=".view.login_setting.ActivityLoginSetting" />
        <!-- 打印标签选择页（通用/宝威/得实 横向Tab） -->
        <activity android:name=".view.login_setting.PrintLabelSelectActivity" />

        <activity android:name=".view.home.MainActivity"
                  android:hardwareAccelerated="true"/>

        <activity android:name=".BatchCopyActivity" android:exported="false"  />
        <activity android:name=".BatchCopyOptionsActivity" android:exported="false" />
        <activity android:name=".view.common.AssetsPickerActivity" android:exported="false" />
        <!-- RFID找资产设置页（查找方式/人员/指定资产） -->
        <activity android:name=".view.rfidfind.FindAssetsSettingActivity" android:exported="false" />
        <!-- 公共选择页：使用部门/管理部门/人员 -->
        <activity android:name=".view.common.CommonSelectActivity" android:exported="false" />
        <activity android:name=".InventoryStatsActivity" android:exported="false" />
        <activity android:name=".ReprintBarcodeActivity" android:exported="false" />

        <activity android:name=".ProtocolActivity" >
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <!-- 添加默认类别以支持隐式意图解析 -->
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="screenOrientation" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.gsoft.inventory.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- H5 附件下载完成通知的点击入口（仅应用内显式广播） -->
        <receiver
            android:name=".service.download.OpenDownloadedFileReceiver"
            android:exported="false" />

        <!-- 高德定位服务 -->
        <receiver android:name=".utils.NetWorkReceiver">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>